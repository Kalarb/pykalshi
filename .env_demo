# --- System Control ---
KALSHI_ENVIRONMENT=DEMO

# --- API Credentials ---
KALSHI_DEMO_API_KEY_ID=<INSERT_PUB_API_KEY>
KALSHI_DEMO_PRIVATE_KEY_FILE=<INSERT_PRIV_API_KEY_FILE_PATH>

# For PROD environment (uncomment when ready):
KALSHI_PROD_API_KEY_ID=<INSERT_PUB_API_KEY>
KALSHI_PROD_PRIVATE_KEY_FILE=<INSERT_PRIV_API_KEY_FILE_PATH>

# --- Rate Limit Fallbacks ---
# Fallback token rates used before auto-configuration resolves on first request,
# and if the /account/limits fetch fails. The client automatically fetches your
# actual tier limits and per-endpoint costs from the API (auto_configure_rates=True).
# These values approximate Kalshi's standard tier as requests-per-second
# (rate=20 with cost=1 per request, before auto-config updates to actual tokens).
KALSHI_RATE_LIMIT_GLOBAL=20.0
KALSHI_RATE_LIMIT_WRITE=10.0

# --- Dev / Debug ---
# KALARB_LOG_LEVEL=DEBUG
